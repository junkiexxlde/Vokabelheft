# DeepL API Key (get from https://www.deepl.com/pro-api)
DEEPL_API_KEY=your-deepl-api-key-here

# Google Translate API Key (optional, requires setup)
GOOGLE_TRANSLATE_API_KEY=your-google-api-key-here

# Bing Translator API Key (Azure Cognitive Services)
# Get from: https://portal.azure.com -> Create resource -> Translator
BING_API_KEY=your-bing-translator-api-key-here

# Mistral AI API Key (for Vokabelheft A.I. translator)
# Get from: https://mistral.ai/
MISTRAL_API_KEY=your-mistral-api-key-here

# Port for the server
PORT=3000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000